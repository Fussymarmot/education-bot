# Bot configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
GROUP_CHAT_ID=-1001234567890

# Database
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Timezone
TIMEZONE=Europe/Moscow

# Shapt.ru integration
SHAPT_CACHE_TTL=300
SHAPT_POLL_INTERVAL=600

# Custom emoji IDs (optional, defaults provided)
ICON_BELLS=5242628160297641831
ICON_LESSONS=5373098009640836781
ICON_SETTINGS=5818705028424141605
ICON_REPLACEMENTS=5264727218734524899
ICON_EDIT=5334673106202010226
ICON_CANCEL=5834629976883732083
ICON_DISABLE=5244807637157029775
ICON_PANEL=5449428597922079323
ICON_CALENDAR=5431897022456145283
ICON_TIME=5451732530048802485
ICON_WARNING=5213181173026533794
ICON_ADDED=
ICON_REMOVED=
ICON_CHANGED=5334673106202010226

# Реакции на сообщения в группе
# REACTIONS_ENABLED=0 выключает реакции полностью
# REACTION_CHANCE - вероятность случайной реакции на сообщение без ключевых слов (0..1, 0.05 = 5%)
REACTIONS_ENABLED=1
REACTION_CHANCE=0.05

# ИИ-собеседник в группе (без AI_API_KEY выключен)
# --- Вариант 1: Cloudflare Workers AI ---
#   AI_API_KEY      - API Token (My Profile -> API Tokens -> шаблон "Workers AI")
#   AI_CF_ACCOUNT_ID - Account ID (Workers & Pages -> Overview, справа)
#   AI_MODEL        - по умолчанию @cf/meta/llama-3.3-70b-instruct-fp8-fast (gpt-oss лучше не брать: течёт <|end|>)
# --- Вариант 2: любой OpenAI-совместимый API (Groq, OpenRouter...) - оставьте AI_CF_ACCOUNT_ID пустым ---
AI_ENABLED=1
AI_API_KEY=
AI_CF_ACCOUNT_ID=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=
AI_TEMPERATURE=0.8
# Имена, на которые отзывается (через запятую); первое - основное
AI_NAMES=Бананыч
# Шанс влезть без спроса / ответить на «не приду, опоздаю» / продолжить диалог (0..1)
AI_RANDOM_CHANCE=0.04
AI_FOLLOWUP_CHANCE=0.5
# Пауза между непрошеными ответами (сек) и общий лимит ответов в час
AI_COOLDOWN=25
AI_MAX_PER_HOUR=40
# Память: сколько последних сообщений хранить/отдавать ИИ и сколько часов они живут
AI_HISTORY_LIMIT=15
AI_HISTORY_TTL_HOURS=6
AI_MAX_TOKENS=200
# Бот может упоминать (с уведомлением) людей, писавших в чат за последние часы; 0 - выключить
AI_MENTIONS=1
