# Bot configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
GROUP_CHAT_ID=-1001234567890

# Database
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Timezone
TIMEZONE=Europe/Moscow

# Shapt.ru integration
SHAPT_CACHE_TTL=300
SHAPT_POLL_INTERVAL=600

# Custom emoji IDs (optional, defaults provided)
ICON_BELLS=5242628160297641831
ICON_LESSONS=5373098009640836781
ICON_SETTINGS=5818705028424141605
ICON_REPLACEMENTS=5264727218734524899
ICON_EDIT=5334673106202010226
ICON_CANCEL=5834629976883732083
ICON_DISABLE=5244807637157029775
ICON_PANEL=5449428597922079323
ICON_CALENDAR=5431897022456145283
ICON_TIME=5451732530048802485
ICON_WARNING=5213181173026533794
ICON_ADDED=
ICON_REMOVED=
ICON_CHANGED=5334673106202010226

# Реакции на сообщения в группе
# REACTIONS_ENABLED=0 выключает реакции полностью
# REACTION_CHANCE - вероятность случайной реакции на сообщение без ключевых слов (0..1, 0.05 = 5%)
REACTIONS_ENABLED=1
REACTION_CHANCE=0.05
